# Help to run a SQL Query and return a pandas Dataframe
@st.cache_data
def query_snowflake(sql: str) -> pd.DataFrame:
    return session.sql(sql).to_pandas()

# Uses average lat/lon for the town matches in the input, to avoid API
@st.cache_data(ttl=3600)
def geocode_address(address: str) -> tuple[float | None, float | None]:
    """Fixed: UPPERCASE TOWN matching."""
    if not address:
        return None, None
    
    # Clean & uppercase search
    search_term = address.upper().strip()[:25]
    
    sql = f"""
        SELECT 
            AVG(LATITUDE) AS lat, 
            AVG(LONGITUDE) AS lon,
            COUNT(*) AS n_properties
        FROM GROUP4_ASG2.FINAL_DATA.PROPWISE_MASTER 
        WHERE UPPER(TOWN) LIKE '%{search_term}%'
        GROUP BY TOWN
        HAVING COUNT(*) >= 10  -- Reliable centroid
        LIMIT 1
    """
    
    try:
        df = query_snowflake(sql)
        if len(df) > 0 and pd.notna(df['lat'].iloc[0]):
            return float(df['lat'].iloc[0]), float(df['lon'].iloc[0])
        return None, None
    except:
        return None, None

# Get recent nearby transactions within a radius around the given point. Used for showing comps and area stats.
@st.cache_data
def get_nearby_sales(lat: float, lon: float, radius_km: float = 1.0) -> pd.DataFrame:
    """Nearby comps for metrics."""
    if lat is None or lon is None: return pd.DataFrame()
    
    sql = f"""
    WITH target_pt AS (SELECT ST_POINT({lon}, {lat})::GEOGRAPHY AS pt)
    SELECT TOWN, FLAT_TYPE, STOREY_RANGE, RESALE_PRICE, LATITUDE, LONGITUDE,
           ROUND(ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt)/1000, 2) as DIST_KM
    FROM GROUP4_ASG2.FINAL_DATA.PROPWISE_MASTER, target_pt
    WHERE ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt) <= {radius_km * 1000}
      AND SALE_YEAR >= 2023
    ORDER BY ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt)
    LIMIT 20
    """
    return query_snowflake(sql)


