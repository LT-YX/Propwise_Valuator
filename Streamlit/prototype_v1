# load the model 
@st.cache_resource
def load_model_from_stage(stage_path):
    try:
        raw_stream = SnowflakeFile.open(stage_path, 'rb')
        with gzip.open(raw_stream, 'rb') as gz:
            model = joblib.load(gz)
        return model
    except Exception as e:
        st.error(f"Model load failed: {e}")
        return None

