@st.cache_data
def query_snowflake(sql: str) -> pd.DataFrame:
    return session.sql(sql).to_pandas()

@st.cache_data
def geocode_address(address: str) -> tuple[float|None, float|None]:
    """Map address → lat/lon using your table."""
    if not address: return None, None
    
    sql = f"""
    SELECT AVG(LATITUDE) as lat, AVG(LONGITUDE) as lon
    FROM GROUP4_ASG2.FINAL_DATA.PROPWISE_MASTER 
    WHERE UPPER(TOWN) LIKE UPPER('%{address[:20]}%')
    GROUP BY TOWN HAVING COUNT(*) > 5 LIMIT 1
    """
    df = query_snowflake(sql)
    return (float(df['lat'].iloc[0]), float(df['lon'].iloc[0])) if len(df) > 0 else (None, None)


@st.cache_data
def get_nearby_sales(lat: float, lon: float, radius_km: float = 1.0) -> pd.DataFrame:
    """Nearby comps for metrics."""
    if lat is None or lon is None: return pd.DataFrame()
    
    sql = f"""
    WITH target_pt AS (SELECT ST_POINT({lon}, {lat})::GEOGRAPHY AS pt)
    SELECT TOWN, FLAT_TYPE, STOREY_RANGE, RESALE_PRICE, LATITUDE, LONGITUDE,
           ROUND(ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt)/1000, 2) as DIST_KM
    FROM GROUP4_ASG2.FINAL_DATA.PROPWISE_MASTER, target_pt
    WHERE ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt) <= {radius_km * 1000}
      AND SALE_YEAR >= 2023
    ORDER BY ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt)
    LIMIT 20
    """
    return query_snowflake(sql)

# predict 
@st.cache_data
def predict_price_ml(town, flat_type, storey_range, max_mrt_dist_m, lat, lon, 
                    fitness, groceries, healthcare, childcare, house_age):
    """Enhanced prediction with binary amenities, MRT slider, and age filter."""
    
    if lat is None or lon is None:
        return 450000, 550000
    
    # Map house_age to YEAR_COMPLETED (assuming current year ~2026)
    current_year = 2026
    age_to_year = {
        '<10 years': f'YEAR_COMPLETED >= {current_year - 10}',
        '<20 years': f'YEAR_COMPLETED >= {current_year - 20}',
        '<30 years': f'YEAR_COMPLETED >= {current_year - 30}',
        '<40 years': f'YEAR_COMPLETED >= {current_year - 40}',
        '<50 years': f'YEAR_COMPLETED >= {current_year - 50}',
        '<60 years': f'YEAR_COMPLETED >= {current_year - 60}',
        '<70 years': f'YEAR_COMPLETED >= {current_year - 70}',
        '<80 years': f'YEAR_COMPLETED >= {current_year - 80}',
        '<90 years': f'YEAR_COMPLETED >= {current_year - 90}',
        '<100 years': 'TRUE'  # All ages
    }
    age_condition = age_to_year.get(house_age, 'TRUE')
    
    # Binary amenity filters (1=Yes/true, 0=No/false)
    amenity_conditions = []
    if fitness: amenity_conditions.append("FITNESS_RECREATION = 1")
    if groceries: amenity_conditions.append("FOOD_GROCERIES = 1")
    if healthcare: amenity_conditions.append("HEALTHCARE_ACCESS = 1")
    if childcare: amenity_conditions.append("CHILDCARE_FAMILY = 1")
    
    amenities_where = ' AND '.join(amenity_conditions) if amenity_conditions else 'TRUE'
    
    sql_features = f"""
    WITH target_pt AS (SELECT ST_POINT({lon}, {lat})::GEOGRAPHY AS pt)
    SELECT 
        COALESCE(OVERALL_AMENITY_SCORE, 0) AS amenity_score,
        COALESCE(SHOPPING_CONVENIENCE_SCORE, 0) AS shopping_score, 
        COALESCE(HEALTHCARE_ACCESSIBILITY_SCORE, 0) AS health_score,
        LEAST(NEAREST_MRT_DISTANCE_M, {max_mrt_dist_m})/1000 AS mrt_km,
        COALESCE(HAWKERS_WITHIN_1KM, 0) AS hawkers,
        COALESCE(MRT_WITHIN_1KM, 0) AS mrt_count,
        COALESCE(YEAR_COMPLETED, 1990) AS year_built,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY RESALE_PRICE) AS baseline_price
    FROM GROUP4_ASG2.FINAL_DATA.PROPWISE_MASTER, target_pt
    WHERE TOWN ILIKE '%{town}%' 
      AND FLAT_TYPE = '{flat_type}'
      AND STOREY_RANGE = '{storey_range}'
      AND {age_condition}
      AND ({amenities_where})
      AND NEAREST_MRT_DISTANCE_M <= {max_mrt_dist_m}
      AND ST_DISTANCE(ST_POINT(LONGITUDE, LATITUDE)::GEOGRAPHY, pt) <= 1500
    GROUP BY 1,2,3,4,5,6,7,8
    LIMIT 1
    """
    
    features_df = query_snowflake(sql_features)
    
    if len(features_df) == 0:
        return 450000, 550000
    
    if model is None:
        median = int(features_df['baseline_price'].iloc[0])
        return int(median * 0.95), int(median * 1.05)
    
    features = np.array([
        features_df['amenity_score'].iloc[0],
        features_df['shopping_score'].iloc[0],
        features_df['health_score'].iloc[0],
        features_df['mrt_km'].iloc[0],
        features_df['hawkers'].iloc[0],
        features_df['mrt_count'].iloc[0],
        features_df['year_built'],  # Use filtered year
        features_df['baseline_price'].iloc[0]
    ]).reshape(1, -1)
    
    try:
        prediction = model.predict(features)[0]
        return int(prediction * 0.95), int(prediction * 1.05)
    except:
        return 450000, 550000

