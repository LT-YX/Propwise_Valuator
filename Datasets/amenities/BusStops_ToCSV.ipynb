import requests
import pandas as pd
import json
import time
from datetime import datetime

class LTADataFetcher:
    def __init__(self, api_key):
        self.api_key = api_key
        self.base_url = "https://datamall2.mytransport.sg/ltaodataservice"
        self.headers = {
            "AccountKey": self.api_key,
            "accept": "application/json"
        }
    
    def fetch_dataset(self, dataset_name, max_records=None):
        """Fetch dataset with optional limit"""
        all_records = []
        skip = 0
        batch_size = 500
        
        print(f"Fetching {dataset_name}...")
        
        while True:
            try:
                url = f"{self.base_url}/{dataset_name}?$skip={skip}"
                response = requests.get(url, headers=self.headers, timeout=30)
                
                if response.status_code != 200:
                    print(f"Error {response.status_code}: {response.text}")
                    break
                
                data = response.json()
                records = data.get('value', [])
                
                if not records:
                    print(f"No more records found at skip={skip}")
                    break
                
                all_records.extend(records)
                print(f"Retrieved {len(records)} records (Total: {len(all_records)})")
                
                if max_records and len(all_records) >= max_records:
                    all_records = all_records[:max_records]
                    print(f"Reached max records limit: {max_records}")
                    break
                    
                if len(records) < batch_size:
                    break
                
                skip += batch_size
                time.sleep(0.1)
                
            except requests.exceptions.RequestException as e:
                print(f"Request failed: {e}")
                break
        
        return all_records
    
    def save_to_csv(self, data, filename):
        if not data:
            print("No data to save")
            return False
        
        df = pd.DataFrame(data)
        filename = f"{filename}.csv"
        
        df.to_csv(filename, index=False, encoding='utf-8')
        print(f"? Saved {len(data)} records to {filename}")
        return True

if __name__ == "__main__":
    API_KEY = "API_KEY" # Replaced it with personal API Key
    
    fetcher = LTADataFetcher(API_KEY)
    
    # Fetch all records
    bus_stops = fetcher.fetch_dataset("BusStops")
    
    # Save to CSV
    fetcher.save_to_csv(bus_stops, "bus_stops")
    
    # Show sample of data
    if bus_stops:
        print("\nSample Bus Stop Data:")
        print(pd.DataFrame(bus_stops[:3]).to_string())